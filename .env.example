# Copy to .env and fill in. Never commit .env.

# Local docker-compose Postgres.
DATABASE_URL=postgresql+psycopg://proposal:proposal@localhost:5432/proposal

# Hosted Postgres (Supabase and equivalents). Use the direct connection
# (port 5432) for migrations and the demo seed; the transaction pooler
# (port 6543) for the running app. get_engine detects port 6543 and disables
# psycopg's prepared statements, which a transaction-mode pooler cannot serve.
# DATABASE_URL=postgresql+psycopg://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres?sslmode=require
# DATABASE_URL=postgresql+psycopg://postgres.PROJECT:PASSWORD@REGION.pooler.supabase.com:6543/postgres?sslmode=require

# fixture = no network, no key, deterministic output. claude = live API.
GENERATION_MODE=fixture
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

STORAGE_DIR=./var/storage
